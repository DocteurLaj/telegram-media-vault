# Public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL source of truth
DATABASE_URL=postgresql://localhost:5432/telegram_vault

# Telegram user API, from https://my.telegram.org
# Keep real values only in the deployed environment or local .env, never in git.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=telegram-vault

# Optional legacy scraper inputs
TELEGRAM_SOURCE_GROUPS=

# Storage mode: links = Telegram links only; download = VPS file only; both = keep Telegram link and save file locally
SCRAPER_STORAGE_MODE=links
SCRAPER_GROUP_STORAGE_MODES=
SCRAPER_DOWNLOAD_DIR=./storage/downloads

# Worker polling
SCRAPER_POLL_GROUPS_MS=60000
SCRAPER_POLL_BACKFILL_MS=15000
